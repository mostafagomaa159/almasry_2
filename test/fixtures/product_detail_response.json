{"data":{"products":{"items":[{"__typename":"SimpleProduct","id":17519,"uid":"MTc1MTk=","sku":"ISG009089","name":"\u0646\u0627\u062a\u0648\u0631\u0627\u0644 \u0639\u0644\u0643\u0629 \u0627\u0644\u0645\u064a\u0644\u0627\u062a\u0648\u0646\u064a\u0646 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0646\u0648\u0645 - \u0628\u0627\u0644\u0641\u0631\u0627\u0648\u0644\u0629 - 5 \u0645\u062c\u0645 90 \u0643\u0628\u0633\u0648\u0644\u0647","description":{"html":"<br><br><strong>\u0648\u0635\u0641 \u0627\u0644\u0645\u0646\u062a\u062c:<\/strong><br>- \u062d\u0644\u0648\u0649 Natrol Melatonin Sleep Aid Gummies \u0628\u0646\u0643\u0647\u0629 \u0627\u0644\u0641\u0631\u0627\u0648\u0644\u0629 \u0647\u064a \u0637\u0631\u064a\u0642\u0629 \u0645\u0644\u0627\u0626\u0645\u0629 \u0648\u0644\u0630\u064a\u0630\u0629 \u0644\u062f\u0639\u0645 \u0646\u0648\u0645 \u0647\u0627\u062f\u0626 \u0644\u064a\u0644\u0627\u064b.<br>- \u0643\u0644 \u0632\u062c\u0627\u062c\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 90 \u0643\u0628\u0633\u0648\u0644\u0629\u060c \u0643\u0644 \u0645\u0646\u0647\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u062c\u0631\u0639\u0629 \u0642\u0648\u064a\u0629 \u0642\u062f\u0631\u0647\u0627 5 \u0645\u0644\u063a \u0645\u0646 \u0627\u0644\u0645\u064a\u0644\u0627\u062a\u0648\u0646\u064a\u0646\u060c \u0648\u0647\u0648 \u0647\u0631\u0645\u0648\u0646 \u064a\u0646\u062a\u062c \u0628\u0634\u0643\u0644 \u0637\u0628\u064a\u0639\u064a \u0641\u064a \u0627\u0644\u062c\u0633\u0645 \u0644\u062a\u0646\u0638\u064a\u0645 \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0646\u0648\u0645 \u0648\u0627\u0644\u0627\u0633\u062a\u064a\u0642\u0627\u0638.<br>- \u062a\u0645 \u062a\u0635\u0645\u064a\u0645 \u0647\u0630\u0647 \u0627\u0644\u062d\u0644\u0648\u0649 \u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0646\u0648\u0645 \u0628\u0634\u0643\u0644 \u0623\u0633\u0631\u0639\u060c \u0648\u0627\u0644\u0628\u0642\u0627\u0621 \u0646\u0627\u0626\u0645\u064b\u0627 \u0644\u0641\u062a\u0631\u0629 \u0623\u0637\u0648\u0644\u060c \u0648\u0627\u0644\u0627\u0633\u062a\u064a\u0642\u0627\u0638 \u0628\u0634\u0639\u0648\u0631 \u0645\u0646\u062a\u0639\u0634 \u0648\u0645\u062c\u062f\u062f.<br>- \u062a\u0636\u064a\u0641 \u0646\u0643\u0647\u0629 \u0627\u0644\u0641\u0631\u0627\u0648\u0644\u0629 \u0637\u0639\u0645\u064b\u0627 \u0644\u0637\u064a\u0641\u064b\u0627 \u0644\u0644\u062d\u0644\u0648\u0649\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644\u0647\u0627 \u0648\u062c\u0628\u0629 \u0644\u0630\u064a\u0630\u0629 \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645.<br>- \u062d\u0644\u0648\u0649 Natrol Melatonin Sleep Aid Gummies \u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u062f\u0648\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 100\u066a \u0648\u0644\u0627 \u062a\u0633\u0628\u0628 \u0627\u0644\u0625\u062f\u0645\u0627\u0646\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644\u0647\u0627 \u062e\u064a\u0627\u0631\u064b\u0627 \u0622\u0645\u0646\u064b\u0627 \u0648\u0641\u0639\u0627\u0644\u064b\u0627 \u0644\u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u0627\u0646\u0648\u0646 \u0645\u0646 \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u0646\u0648\u0645 \u0628\u0634\u0643\u0644 \u0639\u0631\u0636\u064a.<br>- \u0627\u0644\u062d\u0644\u0648\u0649 \u0623\u064a\u0636\u064b\u0627 \u0646\u0628\u0627\u062a\u064a\u0629 \u0648\u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u0646\u0643\u0647\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u0635\u0646\u0627\u0639\u064a\u0629.<br>- \u0628\u0641\u0636\u0644 \u0634\u0643\u0644\u0647\u0627 \u0627\u0644\u0645\u0631\u064a\u062d \u0628\u0634\u0643\u0644 \u0643\u0628\u0633\u0648\u0644\u0629\u060c \u0641\u0625\u0646<br><br><strong>\u062f\u0648\u0627\u0639\u064a \u0627\u0644\u0625\u0633\u062a\u0639\u0645\u0627\u0644:<\/strong><br>- \u064a\u0633\u0627\u0639\u062f \u0641\u064a \u062a\u0639\u0632\u064a\u0632 \u0646\u0648\u0645 \u0623\u0643\u062b\u0631 \u0647\u062f\u0648\u0621\u064b\u0627<br>- \u064a\u0633\u0627\u0639\u062f \u0641\u064a \u062a\u0646\u0638\u064a\u0645 \u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0646\u0648\u0645<br>- \u064a\u062f\u0639\u0645 \u0627\u0644\u0627\u0633\u062a\u0631\u062e\u0627\u0621 \u0648\u0627\u0644\u0647\u062f\u0648\u0621 \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645<br>- \u0642\u062f \u064a\u0633\u0627\u0639\u062f \u0641\u064a \u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0644\u0646\u0648\u0645<br>- \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u0627\u0646\u0648\u0646 \u0645\u0646 \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u0646\u0648\u0645 \u0628\u0634\u0643\u0644 \u0639\u0631\u0636\u064a<br>- \u0645\u062b\u0627\u0644\u064a \u0644\u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u0627\u0646\u0648\u0646 \u0645\u0646 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u0646\u0648\u0645 \u0627\u0644\u0646\u0627\u062c\u0645\u0629 \u0639\u0646 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0623\u0648 \u0627\u0644\u0639\u0645\u0644 \u0628\u0646\u0638\u0627\u0645 \u0627\u0644\u0648\u0631\u062f\u064a\u0627\u062a<br>- \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0646\u0628\u0627\u062a\u064a\u064a\u0646<br>- \u062e\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u0646\u0643\u0647\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u0635\u0646\u0627\u0639\u064a\u0629<br><br><strong>\u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0642\u062a\u0631\u062d:<\/strong><br>\u062a\u0646\u0627\u0648\u0644 \u0642\u0637\u0639\u0629 \u062d\u0644\u0648\u0649 \u0648\u0627\u062d\u062f\u0629 \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645 \u0628\u0640 20 \u062f\u0642\u064a\u0642\u0629. \u0644\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062c\u0631\u0639\u0629 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627.<br><br><strong>\u0637\u0631\u064a\u0642\u0647 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645:<\/strong><br>1. \u062a\u0646\u0627\u0648\u0644 \u062d\u0628\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 Natrol Melatonin Sleep Aid Gummy \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645 \u0628\u0645\u062f\u0629 20-30 \u062f\u0642\u064a\u0642\u0629.<br>2. \u0642\u0645 \u0628\u0645\u0636\u063a \u0627\u0644\u062d\u0628\u0629 \u062c\u064a\u062f\u064b\u0627 \u0642\u0628\u0644 \u0627\u0628\u062a\u0644\u0627\u0639\u0647\u0627.<br>3. \u064a\u064f\u0648\u0635\u0649 \u0628\u0627\u0644\u0628\u062f\u0621 \u0628\u062d\u0628\u0629 \u0648\u0627\u062d\u062f\u0629 (5 \u0645\u0644\u063a) \u0648\u0636\u0628\u0637 \u0627\u0644\u062c\u0631\u0639\u0629 \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u062c\u0629.<br>4. \u0644\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062c\u0631\u0639\u0629 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627 \u0645\u0646 \u062d\u0628\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645.<br>5. \u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u0641\u064a \u0628\u064a\u0626\u0629 \u0646\u0648\u0645 \u0645\u0631\u064a\u062d\u0629 \u0642\u0628\u0644 \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u062d\u0628\u0629.<br>6. \u062a\u062c\u0646\u0628 \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062d\u0648\u0644 \u0623\u0648 \u0627\u0644\u0643\u0627\u0641\u064a\u064a\u0646 \u0642\u0628\u0644 \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u062d\u0628\u0629\u060c \u062d\u064a\u062b \u0642\u062f \u064a\u062a\u062f\u0627\u062e\u0644\u0648\u0646 \u0645\u0639 \u0641\u0639\u0627\u0644\u064a\u062a\u0647\u0627.<br>7. \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0647\u064a \u0627\u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u0623\u0633\u0627\u0633\u064a - \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u062d\u0628\u0629 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a \u0643\u0644 \u0644\u064a\u0644\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u0641\u0636\u0644 \u0627\u0644\u0646\u062a\u0627\u0626\u062c.<br>8. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0623\u064a \u062d\u0627\u0644\u0627\u062a \u0637\u0628\u064a\u0629 \u0623\u0633\u0627\u0633\u064a\u0629 \u0623\u0648 \u062a\u062a\u0646\u0627\u0648\u0644 \u0623\u062f\u0648\u064a\u0629 \u0623\u062e\u0631\u0649\u060c \u0627\u0633\u062a\u0634\u0631 \u0645\u062a\u062e\u0635\u0635 \u0641\u064a \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0642\u0628\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u062a\u062c.<br>9. \u0627\u062d\u0641\u0638 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0645\u063a\u0644\u0642\u0629 \u0628\u0625\u062d\u0643\u0627\u0645 \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u0647\u0627 \u0641\u064a \u0645\u0643\u0627\u0646 \u0628\u0627\u0631\u062f \u0648\u062c\u0627\u0641.<br>10. \u0627\u0628\u0642\u0647\u0627 \u0628\u0639\u064a\u062f\u064b\u0627 \u0639\u0646 \u0645\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0623\u0637\u0641\u0627\u0644.<br><br><strong>\u0627\u0644\u0627\u062b\u0627\u0631 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0647:<\/strong><br>- \u0627\u0644\u0646\u0639\u0627\u0633<br>- \u0627\u0644\u0635\u062f\u0627\u0639<br>- \u0627\u0636\u0637\u0631\u0627\u0628 \u0641\u064a \u0627\u0644\u0645\u0639\u062f\u0629<br>- \u0627\u0644\u062f\u0648\u0627\u0631<br>- \u0627\u0644\u0646\u0639\u0627\u0633 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0647\u0627\u0631<br>- \u0623\u062d\u0644\u0627\u0645 \u062d\u064a\u0629 \u0623\u0648 \u0643\u0648\u0627\u0628\u064a\u0633<br>- \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628 \u0623\u0648 \u0627\u0644\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0632\u0627\u062c\u064a\u0629<br>- \u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u064a\u0642\u0638\u0629 \u0623\u0648 \u0627\u0644\u062a\u0646\u0633\u064a\u0642<br>- \u0627\u0644\u063a\u062b\u064a\u0627\u0646 \u0623\u0648 \u0627\u0644\u0642\u064a\u0621<br>- \u0631\u062f\u0648\u062f \u0641\u0639\u0644 \u062a\u062d\u0633\u0633\u064a\u0629 (\u0637\u0641\u062d \u062c\u0644\u062f\u064a\u060c \u062d\u0643\u0629\u060c \u062a\u0648\u0631\u0645\u060c \u062f\u0648\u0627\u0631 \u0634\u062f\u064a\u062f\u060c \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u062a\u0646\u0641\u0633)<br><br><strong>\u062e\u0635\u0627\u0626\u0635:<\/strong><br><strong>\u0627\u0644\u0627\u0647\u062f\u0627\u0641:<\/strong><br>- \u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u0646\u0648\u0645<br>- \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0627\u0633\u062a\u0631\u062e\u0627\u0621<br>- \u062f\u0639\u0645 \u062f\u0648\u0631\u0629 \u0627\u0644\u0646\u0648\u0645 \u0627\u0644\u0635\u062d\u064a\u0629<br>- \u062a\u0639\u0632\u064a\u0632 \u0645\u062f\u0629 \u0627\u0644\u0646\u0648\u0645 \u0627\u0644\u0639\u0627\u0645\u0629<br>- \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u0646\u0648\u0645 \u0628\u0634\u0643\u0644 \u0623\u0633\u0631\u0639<br><br><strong>\u0627\u0644\u062a\u062e\u0635\u0635:<\/strong><br>- \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 5 \u0645\u0644\u063a \u0645\u0646 \u0627\u0644\u0645\u064a\u0644\u0627\u062a\u0648\u0646\u064a\u0646 \u0641\u064a \u0627\u0644\u062d\u0635\u0629<br>- \u064a\u0623\u062a\u064a \u0628\u0646\u0643\u0647\u0629 \u0627\u0644\u0641\u0631\u0627\u0648\u0644\u0629 \u0627\u0644\u0644\u0630\u064a\u0630\u0629<br>- \u064a\u0648\u0641\u0631 90 \u0643\u0628\u0633\u0648\u0644\u0629 \u0641\u064a \u0627\u0644\u0632\u062c\u0627\u062c\u0629<br>- \u064a\u0633\u0627\u0639\u062f \u0639\u0644\u0649 \u062a\u0639\u0632\u064a\u0632 \u0646\u0648\u0645 \u0647\u0627\u062f\u0626 \u0644\u064a\u0644\u0627\u064b<br>- \u0634\u0643\u0644 \u0627\u0644\u0639\u0644\u0643\u0629 \u0633\u0647\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0644\u0628\u0644\u0639<br>- \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u0627\u0646\u0648\u0646 \u0645\u0646 \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0628\u0644\u0639 \u0627\u0644\u062d\u0628\u0648\u0628<br>- \u0644\u0627 \u064a\u0633\u0628\u0628 \u0627\u0644\u0625\u062f\u0645\u0627\u0646 \u0643\u0645\u0633\u0627\u0639\u062f \u0644\u0644\u0646\u0648\u0645<br>- \u0645\u0635\u0646\u0648\u0639 \u0645\u0646 \u0645\u0643\u0648\u0646\u0627\u062a \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629<br>- \u0645\u0635\u0646\u0639 \u0645\u0646 \u0642\u0628\u0644 Natrol\u060c \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u0641\u064a \u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u0645\u0643\u0645\u0644\u0627\u062a \u0627\u0644\u063a\u0630\u0627\u0626\u064a\u0629<br><br><strong>\u0627\u0644\u062a\u062d\u0630\u064a\u0631\u0627\u062a:<\/strong><br>- \u0627\u0628\u0642\u0647\u0627 \u0628\u0639\u064a\u062f\u0627 \u0639\u0646 \u0645\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0623\u0637\u0641\u0627\u0644<br>- \u0644\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062c\u0631\u0639\u0629 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627<br>- \u0627\u0633\u062a\u0634\u0631 \u0645\u062a\u062e\u0635\u0635 \u0641\u064a \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0625\u0630\u0627 \u0643\u0646\u062a \u062d\u0627\u0645\u0644\u0627\u064b\u060c \u0623\u0648 \u062a\u0631\u0636\u0639\u060c \u0623\u0648 \u062a\u062a\u0646\u0627\u0648\u0644 \u0623\u062f\u0648\u064a\u0629<br>- \u0642\u062f \u064a\u0633\u0628\u0628 \u0627\u0644\u0646\u0639\u0627\u0633\u061b \u0644\u0627 \u062a\u0642\u0648\u062f \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0623\u0648 \u062a\u0634\u063a\u0644 \u0627\u0644\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u062b\u0642\u064a\u0644\u0629 \u0628\u0639\u062f \u062a\u0646\u0627\u0648\u0644\u0647<br>- \u0642\u0627\u0637\u0639 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0633\u062a\u0634\u0631 \u0645\u062a\u062e\u0635\u0635 \u0641\u064a \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0639\u0627\u0646\u064a \u0645\u0646 \u0623\u064a \u0631\u062f\u0648\u062f \u0641\u0639\u0644 \u0633\u0644\u0628\u064a\u0629<br>- \u064a\u062d\u0641\u0638 \u0641\u064a \u0645\u0643\u0627\u0646 \u0628\u0627\u0631\u062f \u0648\u062c\u0627\u0641<br>- \u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u062e\u062a\u0645 \u0645\u0643\u0633\u0648\u0631\u064b\u0627 \u0623\u0648 \u0645\u0641\u0642\u0648\u062f\u064b\u0627<br><br><strong>\u0645\u0644\u0627\u062d\u0638\u0629:<br>\u062a\u0633\u0639\u0649 \u0635\u064a\u062f\u0644\u064a\u0629 \u0627\u0644\u0645\u0635\u0631\u064a \u062c\u0627\u0647\u062f\u0629 \u0644\u0636\u0645\u0627\u0646 \u062f\u0642\u0629 \u0635\u0648\u0631 \u0645\u0646\u062a\u062c\u0627\u062a\u0647\u0627 \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0639\u0646\u0647\u0627. \u0642\u062f \u064a\u062d\u062f\u062b \u0628\u0639\u0636 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0641\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0635\u0646\u064a\u0639 \u0644\u0644\u0639\u0628\u0648\u0627\u062a \u0648\/\u0623\u0648 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a\u060c \u0648\u0633\u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0647\u0630